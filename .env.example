# ---- Supabase (bulut saqlash + kirish). Bo'sh qolsa ilova faqat qurilmada (mehmon) ishlaydi ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Yangi loyihalarda: Settings -> API Keys -> Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Eski loyihalarda (legacy): anon key. Ikkalasidan bittasi yetarli.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Jadval prefiksi (ixtiyoriy; standart "moliya_" — schema.sql bilan bir xil bo'lsin)
NEXT_PUBLIC_TABLE_PREFIX=

# Google orqali kirish tugmasini ko'rsatish (Supabase'da Google provider sozlangan bo'lsa) — 1 yoki bo'sh
NEXT_PUBLIC_ENABLE_GOOGLE=

# ---- AI (ixtiyoriy). Rasmiy API kalitlari — obuna emas. Faqat server tomonida ishlatiladi ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Modellar (ixtiyoriy; standart qiymatlar kodda)
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

# Serverdagi AI kaliti va parolni tiklash faqat shu emaillar uchun (vergul bilan)
ALLOWED_EMAILS=valijonibroximov@gmail.com

# ---- Parolni tiklash — kod Telegram'dagi rasmiy "Verification Codes" akkauntidan keladi ----
# Token: https://gateway.telegram.org (Telegram akkauntingiz bilan kirib, API token oling)
# O'z raqamingizga kod yuborish Telegram tomonidan BEPUL
TELEGRAM_GATEWAY_TOKEN=
# Telegram raqamingiz, E.164 formatda
RESET_PHONE=+998901234567
# Supabase -> Project Settings -> API Keys -> Secret key (sb_secret_...). FAQAT server uchun, NEXT_PUBLIC_ EMAS!
SUPABASE_SECRET_KEY=
